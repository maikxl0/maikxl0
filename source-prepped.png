<svg xmlns="http://www.w3.org/2000/svg" width="640" height="413"
     viewBox="0 0 640 413" role="img" aria-label="Ficha estilo neofetch">
  <style>
    text { font-family:ui-monospace,'SFMono-Regular','JetBrains Mono','Fira Code',Menlo,Consolas,monospace; font-size:14.0px; }
    .k   { fill:#39d353; font-weight:700; }
    .val { fill:#c9d1d9; }
    .dim { fill:#8b949e; }
    .ln { opacity:0; animation: in .45s cubic-bezier(.2,.7,.3,1) forwards; }
    @keyframes in { from { opacity:0; transform:translateX(-10px); }
                    to   { opacity:1; transform:none; } }
    @media (prefers-reduced-motion: reduce) {
      .ln { opacity:1; animation:none; } }
  </style>
  <rect width="100%" height="100%" fill="#0d1117" rx="10"/>
  <rect x="0" y="0" width="640" height="32" fill="#161b22"
        rx="10"/>
  <rect x="0" y="22" width="640" height="10" fill="#161b22"/>
  <circle cx="32" cy="22" r="5.5" fill="#ff5f57"/><circle cx="50" cy="22" r="5.5" fill="#febc2e"/><circle cx="68" cy="22" r="5.5" fill="#28c840"/>
  <text class="ln k" x="26" y="70" style="animation-delay:0.20s">maikxl0@github</text>
  <text class="ln dim" x="26" y="89" style="animation-delay:0.30s">──────────────</text>
  <text class="ln dim" x="26" y="114" style="animation-delay:0.40s">welcome to my repository</text>
  <text class="ln k" x="26" y="145" style="animation-delay:0.50s">Role</text>
  <text class="ln val" x="118.4" y="145" style="animation-delay:0.50s">Full-Stack Developer</text>
  <text class="ln k" x="26" y="174" style="animation-delay:0.60s">Doing</text>
  <text class="ln val" x="118.4" y="174" style="animation-delay:0.60s">Showcasing my work and projects here</text>
  <text class="ln k" x="26" y="203" style="animation-delay:0.70s">Stack</text>
  <text class="ln val" x="118.4" y="203" style="animation-delay:0.70s">Web   ·  TypeScript · JavaScript · Node</text>
  <text class="ln val" x="118.4" y="228" style="animation-delay:0.80s">ML    ·  Python · YOLO · Computer Vision</text>
  <text class="ln k" x="26" y="257" style="animation-delay:0.90s">Recent</text>
  <text class="ln val" x="118.4" y="257" style="animation-delay:0.90s">Novahabitat</text>
  <text class="ln val" x="118.4" y="282" style="animation-delay:1.00s">Restaurante la Terraza</text>
  <text class="ln k" x="26" y="311" style="animation-delay:1.10s">Open to</text>
  <text class="ln val" x="118.4" y="311" style="animation-delay:1.10s">Collaboration and new projects</text>
  <text class="ln k" x="26" y="340" style="animation-delay:1.20s">Profile</text>
  <text class="ln val" x="118.4" y="340" style="animation-delay:1.20s">github.com/maikxl0</text>
  <rect class="ln" x="26" y="375" style="animation-delay:1.30s" width="22" height="12" rx="2" fill="#161b22"/>
  <rect class="ln" x="54" y="375" style="animation-delay:1.40s" width="22" height="12" rx="2" fill="#0e4429"/>
  <rect class="ln" x="82" y="375" style="animation-delay:1.50s" width="22" height="12" rx="2" fill="#006d32"/>
  <rect class="ln" x="110" y="375" style="animation-delay:1.60s" width="22" height="12" rx="2" fill="#26a641"/>
  <rect class="ln" x="138" y="375" style="animation-delay:1.70s" width="22" height="12" rx="2" fill="#39d353"/>
  <rect class="ln" x="166" y="375" style="animation-delay:1.80s" width="22" height="12" rx="2" fill="#69f0a0"/>
</svg>
